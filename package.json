{
  "name": "delta-v",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:client": "node esbuild.client.mjs",
    "build": "npm run build:client",
    "dev": "wrangler dev",
    "dev:watch": "node esbuild.watch.mjs & wrangler dev",
    "deploy": "node scripts/check-deploy-secrets.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:tools",
    "test": "NODE_OPTIONS=--localstorage-file=/tmp/deltav-vitest-localstorage vitest run",
    "test:coverage": "rm -rf coverage && npm run test:coverage:client && npm run test:coverage:server",
    "test:coverage:client": "NODE_OPTIONS=--localstorage-file=/tmp/deltav-vitest-localstorage vitest run --config vitest.coverage.client.config.ts --coverage --no-file-parallelism",
    "test:coverage:server": "NODE_OPTIONS=--localstorage-file=/tmp/deltav-vitest-localstorage vitest run --config vitest.coverage.server.config.ts --coverage --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/gameplay-lifecycle.spec.ts e2e/multiplayer.spec.ts e2e/scenario-smoke.spec.ts e2e/single-player.spec.ts e2e/spectator.spec.ts",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:watch": "vitest",
    "verify": "npm run verify:full",
    "verify:quick": "npm run lint && npm run check:csp && npm run typecheck:all && npm run build",
    "verify:full": "npm run lint && npm run check:csp && npm run typecheck:all && npm run test:coverage && npm run build && npm run test:e2e:smoke && npm run test:e2e:a11y && npm run simulate all 60 -- --ci",
    "lint": "biome check src packages scripts e2e vitest.config.ts playwright.config.ts esbuild.client.mjs esbuild.watch.mjs scripts/bundle-style-css.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:csp": "node scripts/check-csp-hashes.mjs",
    "diagrams": "node scripts/render-diagrams.mjs",
    "check:diagrams": "node scripts/check-diagrams.mjs",
    "lint:fix": "biome check --write src packages scripts e2e vitest.config.ts playwright.config.ts esbuild.client.mjs esbuild.watch.mjs scripts/bundle-style-css.mjs",
    "format": "biome format --write src packages scripts e2e vitest.config.ts playwright.config.ts esbuild.client.mjs esbuild.watch.mjs scripts/bundle-style-css.mjs",
    "simulate": "tsx scripts/simulate-ai.ts",
    "simulate:smoke": "tsx scripts/simulate-ai.ts all 3 --ci --quiet",
    "simulate:duel-sweep": "tsx scripts/duel-seed-sweep.ts",
    "llm:player": "tsx scripts/llm-player.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "llm:agent:recommended": "tsx scripts/llm-agent-recommended.ts",
    "llm:agent:coach": "tsx scripts/llm-agent-coach.ts",
    "llm:agent:claude": "npx tsx scripts/llm-agent-claude.ts",
    "llm:agent:groq": "tsx scripts/llm-agent-groq.ts",
    "mcp:delta-v": "tsx scripts/delta-v-mcp-server.ts",
    "mcp:delta-v:http": "tsx scripts/delta-v-mcp-server.ts --http",
    "mcp:sandbox-smoke": "tsx scripts/mcp-sandbox-smoke.ts",
    "quickmatch:scrimmage": "tsx scripts/quick-match-scrimmage.ts",
    "quickmatch:agent": "tsx scripts/quick-match-agent.ts",
    "load:test": "tsx scripts/load-test.ts",
    "update-deps": "npx npm-check-updates -u && npm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.4.15",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.2",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.107.0",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@delta-v/mcp-adapter": "workspace:*",
    "@sentry/cloudflare": "^10.65.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "body-parser": "2.3.0",
    "fast-uri": "4.1.2",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  }
}
